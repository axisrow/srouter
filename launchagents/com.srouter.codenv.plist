<?xml version="1.0" encoding="UTF-8"?>
<!-- __SROUTER_CODENV_MARKER__ -->
<!-- srouter: residual-чистка gui-домена launchd (контракт маршрутизации 2026-10-07: ambient
     env-прокси не сеется ни в один слой). RunAtLoad (при входе/ребут) + каждые 5мин: скрипт
     srouter-codex-env.sh снимает через launchctl unsetenv ВСЕ шесть прокси-ключей
     (HTTP(S)_PROXY, ALL_PROXY, оба регистра) — setenv не ретроактивен и не снимает чужое,
     поэтому periodic-чистка делает «в gui-домене нет ambient-прокси» инвариантом (residual
     старых версий скрипта: socks5h ALL_PROXY и privoxy-http scheme-ключи, #331/#340).
     Через туннель ходит только явно попросившее: xray-правила, git per-host, per-tool
     wrappers (codex-srouter — socks5h точечно #120), curl -x. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__SROUTER_CODENV_LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__SROUTER_CODENV_PATH__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__SROUTER_LOG_OUT__</string>
  <key>StandardErrorPath</key>
  <string>__SROUTER_LOG_ERR__</string>
</dict>
</plist>
