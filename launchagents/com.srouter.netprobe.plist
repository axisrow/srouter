<?xml version="1.0" encoding="UTF-8"?>
<!-- __SROUTER_NETPROBE_MARKER__ -->
<!-- Диагностика участков сети: раз в 60с ping -c 3 до gateway/domestica/VPS (мимо туннеля),
     JSONL в ~/Library/Logs/srouter-netprobe.jsonl (~1 МБ/сутки). Установка: `srouter netprobe apply`,
     снятие: `srouter netprobe stop`, отчёт корреляции с блэкаутами туннеля: `srouter netprobe report`.
     Кампания деградации туннеля 2026-09, см. diag_netprobe.py (docstring). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__SROUTER_NETPROBE_LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SROUTER_PYTHON_BIN__</string>
    <string>__SROUTER_NETPROBE_PATH__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SROUTER_ROOT_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__SROUTER_LOG_OUT__</string>
  <key>StandardErrorPath</key>
  <string>__SROUTER_LOG_ERR__</string>
</dict>
</plist>
